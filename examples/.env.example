# Create this key with `gnt keys create`; it is required by every example.
GNT_MCP_KEY=gnt_live_replace_me

# Override only when using a self-hosted gnt deployment.
GNT_MCP_URL=https://api.gntai.dev/mcp/

# Required only for anthropic-tool-use-check-action.ts.
ANTHROPIC_API_KEY=sk-ant-replace_me
ANTHROPIC_MODEL=claude-haiku-4-5
