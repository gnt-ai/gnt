DATABASE_URL=postgresql+asyncpg://gnt_app:change-me@localhost:5432/gnt
# Privileged connection for `alembic upgrade` only — gnt_app deliberately
# can't run DDL. Must be a genuine Postgres SUPERUSER, not just a schema/
# table owner with broad DDL grants: migration 0014's CREATE ROLE ... WITH
# BYPASSRLS is reserved to real superusers specifically, and this
# connection is what runs it. A non-superuser role here fails migration
# 0014 with a clear permission error.
MIGRATION_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gnt
# BYPASSRLS connection for the one cron job that legitimately needs to
# touch every org's data in a single statement (decay_confidence — see
# migration 0014). Never used by request-scoped application code. Unlike
# MIGRATION_DATABASE_URL, leaving this unset fails loudly at worker
# startup (see db/session.py's get_cron_engine) rather than silently —
# there is no safe fallback, since gnt_app's DML grants would let the
# cron job's UPDATE "succeed" while matching zero rows under RLS.
CRON_DATABASE_URL=postgresql+asyncpg://gnt_cron:change-me@localhost:5432/gnt
# BYPASSRLS connection for the internal platform-admin dashboard (migration
# 0035) — SELECT across every org, plus a column-scoped UPDATE on
# orgs.plan_tier/subscription_status only. Same "no safe fallback, fail
# loudly if unset" reasoning as CRON_DATABASE_URL — see
# db/session.py's get_admin_engine.
ADMIN_DATABASE_URL=postgresql+asyncpg://gnt_admin:change-me@localhost:5432/gnt
# Comma-separated allowlist — a signed-in user whose email is on this list
# can use the platform-admin dashboard (auth/better_auth.py's
# require_platform_admin). Founder-only env var, not a DB-backed role.
PLATFORM_ADMIN_EMAILS=you@example.com
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

CONTRIBUTOR_HASH_SECRET=change-me-to-a-random-secret

# Also Better Auth's jwt plugin iss/aud and JWKS base — see config.py's
# web_origin comment.
WEB_ORIGIN=http://localhost:3000

# This API's own public origin — see config.py's api_origin for why it
# has to byte-for-byte match what's registered in the Slack app settings.
API_ORIGIN=http://localhost:8000

# Slack connector (gnt/slack/oauth.py) — client id/secret/signing secret
# come from a Slack app you create yourself at api.slack.com. State
# secret and token encryption key are generated locally
# (`openssl rand -hex 32` / `openssl rand -base64 32`), never shared with
# Slack.
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_SIGNING_SECRET=...
SLACK_STATE_SECRET=change-me-to-a-random-secret
SLACK_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# GitHub connector (git-native rules storage, PAT-based per-org connect
# flow) — its own dedicated Fernet key, deliberately not
# SLACK_TOKEN_ENCRYPTION_KEY (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
GITHUB_PAT_ENCRYPTION_KEY=change-me-to-a-fernet-key

# GitHub App (replaces the PAT flow above as the default connect path) —
# registered once under the gnt-ai org, App ID/client ID are public. Private
# key is the App's RSA keypair (PEM, generate/download from the app's
# settings page); webhook secret is whatever's configured under the app's
# "Webhook" section. Optional — unset locally means `gnt connect github`
# falls back to the legacy PAT prompt (--pat), nothing else breaks.
# GITHUB_APP_ID=...
# GITHUB_APP_CLIENT_ID=...
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=...

# Zendesk connector (connector sprint T4.2, continuous server-side sync —
# workers/tasks_zendesk.py) — a self-serve API token per org, generated in
# the customer's own Zendesk admin. Its own dedicated Fernet key, same
# reasoning as GITHUB_PAT_ENCRYPTION_KEY above (generate the same way).
ZENDESK_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# Intercom connector (connector sprint T4.3, continuous server-side sync —
# workers/tasks_intercom.py) — a self-serve Personal Access Token per org,
# generated in the customer's own workspace Developer Hub. Its own
# dedicated Fernet key, same reasoning as GITHUB_PAT_ENCRYPTION_KEY above
# (generate the same way).
INTERCOM_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# Notion connector (OAuth sprint T14 dashboard track) — client id/secret
# came from Notion's own dynamic client registration endpoint
# (mcp.notion.com/register), registered once against this API's
# https://<api_origin>/v1/notion/oauth/callback. State secret and token
# encryption key are generated locally, same convention as Slack's above.
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...
NOTION_STATE_SECRET=change-me-to-a-random-secret
NOTION_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# Linear connector (OAuth sprint T14 dashboard track) — reuses the same
# OAuth app the CLI's own connect-linear-mcp.ts uses
# (linear.app/settings/api/applications), with this API's
# https://<api_origin>/v1/linear/oauth/callback added as a second
# registered Redirect URI on that app. No client secret — PKCE covers it,
# same reasoning the CLI's own oauth.ts documents.
LINEAR_CLIENT_ID=...
LINEAR_STATE_SECRET=change-me-to-a-random-secret
LINEAR_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

# apps/store's internal API (Migration Phase 4) — generate both with
# `openssl rand -hex 32`, and set the exact same STORE_INTERNAL_API_SECRET
# value as GNT_STORE_INTERNAL_API_SECRET in apps/store's own env, and the
# exact same APPROVAL_SIGNING_SECRET value as GNT_APPROVAL_SIGNING_SECRET
# there too — both sides of each secret must match.
STORE_API_URL=http://127.0.0.1:8787
STORE_INTERNAL_API_SECRET=change-me-to-a-random-secret
APPROVAL_SIGNING_SECRET=change-me-to-a-different-random-secret

# Optional — error monitoring. Leave unset in local dev/CI; sentry_sdk.init
# no-ops without a DSN. Set this in Railway's dashboard for production, not
# here.
# SENTRY_DSN=https://...@....ingest.us.sentry.io/...

# Optional — billing (routers/billing.py). Leave all three unset in local
# dev/CI; checkout/portal calls fail loud with BillingNotConfigured
# instead of silently no-opping. STRIPE_WEBHOOK_SECRET comes from the
# webhook endpoint you register in the Stripe dashboard pointed at
# https://<api-host>/v1/billing/webhook.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# BILLING_TRIAL_DAYS=14
