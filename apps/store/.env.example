# Internal API (src/http/server.ts) — apps/api-to-apps/store only, never
# public. Must match STORE_INTERNAL_API_SECRET in apps/api's own env.
GNT_STORE_PORT=8787
GNT_STORE_BIND=127.0.0.1
GNT_STORE_INTERNAL_API_SECRET=change-me-to-a-random-secret

# Required — NativeStore is Postgres-only, no in-memory mode. Plain
# postgres:// connection string (not the postgresql+asyncpg:// form
# apps/api uses).
DATABASE_URL=postgres://user:password@localhost:5432/gnt_store

# Where the engine clones org rules repos to disk. Defaults to a tmpdir
# if unset — set this explicitly in production to a persistent volume
# path if repo clones should survive a restart instead of re-cloning.
# GNT_STORE_CLONES_DIR=/data/gnt-store-clones

# Authorizes specifically an approved-status write (see
# src/core/approval-signing.ts) — a different secret from
# GNT_STORE_INTERNAL_API_SECRET above. Must match APPROVAL_SIGNING_SECRET
# in apps/api's own env.
GNT_APPROVAL_SIGNING_SECRET=change-me-to-a-different-random-secret

# Embeddings/reranking for rule search (native/embed.ts, native/rerank.ts)
# under STORE_BACKEND=native. Not read at startup — the store process boots
# fine without it — but any call that actually embeds or reranks a rule
# throws EmbedError at request time. Get a key at zeroentropy.dev.
ZEROENTROPY_API_KEY=

# Test-only — a deterministic non-semantic embedding stub instead of a
# real embedding call. Never set this outside tests.
# GNT_STORE_TEST_FAKE_EMBED=1
