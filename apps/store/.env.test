# Bun auto-loads .env.test (this file) OVER .env whenever NODE_ENV=test,
# which `bun test` sets automatically. apps/store/.env carries a real
# ZEROENTROPY_API_KEY for local dev — without this override, `bun test`
# would inherit that real key, and gnt-fix-plan-v2 item 11's search() now
# calls the vendored engine's hybridSearch(), which embeds (and can
# rerank) the query itself through the gateway rather than through the
# fakeEmbed function this suite injects for writes. Global Rule 6: no real
# paid provider calls from a test loop. Blanking the key here makes the
# gateway's own isAvailable() checks fail closed automatically, no matter
# what test file runs or what it constructs EngineStore with.
ZEROENTROPY_API_KEY=
