{
  "name": "@gnt-ai/cli",
  "version": "0.6.0",
  "description": "gnt.ai from your terminal: connect apps, propose rules, query your brain.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://gntai.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnt-ai/gnt.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/gnt-ai/gnt/issues",
