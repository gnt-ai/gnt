    "eval:extraction": "bun run eval/extraction/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.6.2",
