# apps/api, local by default
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth — same physical Postgres apps/api's Alembic migrations
# manage (Better Auth owns its own tables: user, session, account,
# organization, member, invitation, jwks, ...). Needs a role with DDL
# rights to run `pnpm exec better-auth migrate` (NOT the restricted
# gnt_app role apps/api's runtime uses).
DATABASE_URL=postgresql://user@localhost/gnt
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional — omit a provider's pair entirely to leave that "Sign in with
# X" button off rather than shipping a broken one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional — omit to fall back to logging invitation emails instead of
# sending them (see lib/email.ts). Get a key at resend.com; the default
# RESEND_FROM_EMAIL (onboarding@resend.dev) needs no verified domain but
# only delivers to the email your Resend account itself was created with.
# Once a real domain is verified there, set RESEND_FROM_EMAIL to an
# address on it to unlock sending to arbitrary recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
