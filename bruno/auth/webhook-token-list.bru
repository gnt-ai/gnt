meta {
  name: webhook-token list
  type: http
  seq: 12
}

get {
  url: {{api_base_url}}/v1/settings/webhook-tokens
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cli_api_key}}
}

docs {
  GET /v1/settings/webhook-tokens — get_current_org, any org-scoped key
  can list (only minting/revoking require admin).
}

assert {
  res.status: eq 200
  res.body: isArray
}
