meta {
  name: create rule (draft)
  type: http
  seq: 1
}

post {
  url: {{api_base_url}}/v1/rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{mcp_api_key}}
}

body:json {
  {
    "title": "bruno smoke test rule",
    "body": "This draft rule exists only to exercise the rules lifecycle contract end to end (create, get, submit, propose, reject, deprecate, edit).",
    "confidence": 0.6,
    "tags": ["bruno-smoke-test"]
  }
}

docs {
  POST /v1/rules — routers/rules.py's create_rule. get_current_org, any
  org-scoped key can create a draft. Kicks off this folder's lifecycle
  chain — every other request here (get/submit/propose/batch-propose/
  reject/deprecate/edit) targets the rule id this one creates via
  {{last_rule_id}}, so run this folder in seq order (or the whole
  collection) for the chain to hold together.
}

script:post-response {
  bru.setVar("last_rule_id", res.getBody().id);
}

assert {
  res.status: eq 201
  res.body.status: eq draft
  res.body.confidence_estimate: eq true
}
